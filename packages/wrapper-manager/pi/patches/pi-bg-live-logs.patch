+  public readJobOutput(job: BgJob): string {
+    if (job.liveOutput !== undefined) return job.liveOutput;
+    if (!job.outputPath) return "";
+    try {
+      return sanitizeTerminalOutput(readFileSync(job.outputPath, "utf8"));
+    } catch {
+      return "";
+    }
+  }
+
+  public async showLogs(ctx: ExtensionContext, pid: number) {
+    if (!this.jobs.has(pid)) {
+      ctx.ui.notify(`No background job found with ID ${pid}`, "error");
+      return;
+    }
+
+    await ctx.ui.custom<void>((tui, theme, _keybindings, done) => {
+      let timer: ReturnType<typeof setInterval> | undefined;
+      const close = () => {
+        if (timer) clearInterval(timer);
+        timer = undefined;
+        done(undefined);
+      };
+      timer = setInterval(() => tui.requestRender(), 500);
+      timer.unref?.();
+
+      return {
+        render: (width: number) => {
+          const safeWidth = Math.max(1, width);
+          const job = this.jobs.get(pid);
+          const heading = job
+            ? `Background job ${pid} (${Math.round((Date.now() - job.startedAt) / 1000)}s)`
+            : `Background job ${pid} finished`;
+          const output = job ? this.readJobOutput(job) : "";
+          const outputLines = output
+            .replace(/\r\n?/g, "\n")
+            .split("\n")
+            .slice(-100);
+          const lines = [
+            theme.fg("accent", theme.bold(heading)),
+            job ? theme.fg("muted", job.command) : "",
+            "",
+            ...(outputLines.some((line) => line.length > 0)
+              ? outputLines
+              : ["(no output yet)"]),
+            "",
+            theme.fg("dim", "Live output · Esc to close"),
+          ];
+          return lines.map((line) =>
+            truncateToWidth(line.replace(/\t/g, "   "), safeWidth, ""),
+          );
+        },
+        handleInput: (data: string) => {
+          if (matchesKey(data, "escape") || data === "q") close();
+        },
+        invalidate() {},
+      };
+    });
+  }
+
