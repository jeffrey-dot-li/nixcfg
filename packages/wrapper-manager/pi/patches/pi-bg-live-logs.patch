+test("returns output from a running job", async () => {
+  const { bg, pending, manager, ctx } = setup();
+  const command = `${shellQuote(process.execPath)} -e ${shellQuote("process.stdout.write('ready'); setTimeout(() => {}, 1000)")}`;
+
+  const started = await bg.execute(
+    "live",
+    { command },
+    undefined,
+    undefined,
+    ctx,
+  );
+  const pid = JSON.parse(started.content[0].text).pid;
+  await new Promise((resolve) => setTimeout(resolve, 100));
+  const logs = await bg.execute(
+    "logs",
+    { action: "logs", pid, lines: 20 },
+    undefined,
+    undefined,
+    ctx,
+  );
+
+  assert.equal(JSON.parse(logs.content[0].text).output, "ready");
+  manager.killJob(pid);
+  await pending[0];
+});
