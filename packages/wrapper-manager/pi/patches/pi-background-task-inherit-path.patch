@@ -91,0 +92,13 @@
+// A login shell rebuilds PATH from the user's profile, which can bury entries
+// that were first in the terminal Pi started from (venv, direnv, nix shell).
+// Put Pi's PATH back in front, keeping anything the profile added after it.
+function commandWithInheritedPath(meta) {
+    const inherited = meta.inheritedPath;
+    if (typeof inherited !== "string" || inherited === "")
+        return meta.command;
+    const fish = /(^|\/)fish$/.test(meta.shell);
+    const prelude = fish
+        ? `set -gx PATH (string split : -- '${inherited.replaceAll("\\", "\\\\").replaceAll("'", "\\'")}') $PATH`
+        : `PATH='${inherited.replaceAll("'", "'\\''")}':"$PATH"; export PATH`;
+    return `${prelude}\n${meta.command}`;
+}
