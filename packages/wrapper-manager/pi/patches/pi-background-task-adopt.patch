+// Runner for an adopted command: a process Pi already started (the bash tool's
+// child) that outlived its foreground limit. The command keeps running as Pi's
+// child, writing to `meta.adopted.output`; this runner lives in the task's tmux
+// pane, replays that output into the pane (so pipe-pane fills output.log and the
+// screen is live), forwards cancellation to the command's process group, and
+// writes result.json from the exit status Pi records in `meta.adopted.exit`.
+import { closeSync, existsSync, linkSync, openSync, readFileSync, readSync, rmSync, unlinkSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+const taskDir = process.argv[2];
+if (!taskDir)
+    throw new Error("Task directory argument is required");
+const metaPath = join(taskDir, "meta.json");
+const resultPath = join(taskDir, "result.json");
+const gatePath = join(taskDir, "start.signal");
+const cancelPath = join(taskDir, "cancel.json");
+const meta = JSON.parse(readFileSync(metaPath, "utf8"));
+const { pid, output, exit } = meta.adopted;
+// Signal handling comes first: task_kill can arrive while this runner is still
+// starting, and the default SIGINT/SIGHUP action would end the pane without
+// stopping the command. The registry also signals the group directly.
+let startedAt;
+// Ctrl+C in the pane (task_kill's graceful step) reaches only this runner, since
+// the command is not in the pane's process group; forward it.
+process.on("SIGINT", () => signalGroup("SIGINT"));
+for (const signal of ["SIGTERM", "SIGHUP"]) {
+    process.on(signal, () => {
+        // Forced termination (kill-session or Pi quitting): the graceful Ctrl+C
+        // step has already been tried, so stop the whole group.
+        // Record the result first: the pane is closing, so writing to it may fail.
+        if (startedAt)
+            finalize(null, signal, "runner terminated");
+        signalGroup("SIGKILL");
+        process.exit(128);
+    });
+}
+const POLL_MS = 100;
+// Writes to a pane that tmux is tearing down fail asynchronously; ignore them.
+process.stdout.on("error", () => undefined);
+// The exit file is written when Pi sees the child's stdio close, which can
+// trail the process group's last member by a moment.
+const EXIT_GRACE_MS = 2_000;
+await waitForGate(gatePath, 10_000);
+startedAt = meta.adoptedStartedAt ?? new Date().toISOString();
+let finalized = false;
+let fd;
+const buffer = Buffer.alloc(64 * 1024);
+function drain() {
+    try {
+        fd ??= openSync(output, "r");
+        for (;;) {
+            const read = readSync(fd, buffer, 0, buffer.length, null);
+            if (read <= 0)
+                return;
+            process.stdout.write(buffer.subarray(0, read));
+        }
+    }
+    catch {
+        // Output file not created yet or already cleaned up; nothing to replay.
+    }
+}
+function cancellation() {
+    try {
+        return JSON.parse(readFileSync(cancelPath, "utf8"));
+    }
+    catch {
+        return undefined;
+    }
+}
+function groupAlive() {
+    try {
+        process.kill(-pid, 0);
+        return true;
+    }
+    catch (error) {
+        return error.code === "EPERM";
+    }
+}
+function signalGroup(signal) {
+    try {
+        process.kill(-pid, signal);
+    }
+    catch {
+        // Already gone.
+    }
+}
+function finalize(exitCode, signal, fallbackReason) {
+    if (finalized || existsSync(resultPath))
+        return;
+    finalized = true;
+    const cancel = cancellation();
+    const status = cancel
+        ? cancel.reason === "timed_out"
+            ? "timed_out"
+            : "cancelled"
+        : fallbackReason === "runner terminated"
+            ? "interrupted"
+            : exitCode === 0
+                ? "completed"
+                : "failed";
+    const reason = cancel?.reason ?? fallbackReason;
+    const result = {
+        schemaVersion: 1,
+        taskId: meta.taskId,
+        status,
+        exitCode,
+        signal,
+        startedAt,
+        endedAt: new Date().toISOString(),
+        ...(reason ? { reason } : {}),
+    };
+    const temp = `${resultPath}.${process.pid}.tmp`;
+    writeFileSync(temp, `${JSON.stringify(result, null, 2)}\n`, { mode: 0o600, flag: "wx" });
+    try {
+        linkSync(temp, resultPath);
+    }
+    catch (error) {
+        if (error.code !== "EEXIST")
+            throw error;
+    }
+    finally {
+        unlinkSync(temp);
+    }
+    if (fd !== undefined)
+        closeSync(fd);
+    // The output and exit files live in a private temporary directory owned by
+    // this hand-off; output.log now holds the complete stream.
+    rmSync(dirname(output), { recursive: true, force: true });
+}
+function readExit() {
+    try {
+        return JSON.parse(readFileSync(exit, "utf8"));
+    }
+    catch {
+        return undefined;
+    }
+}
+let goneSince;
+for (;;) {
+    drain();
+    const status = readExit();
+    if (status) {
+        drain();
+        finalize(status.exitCode ?? null, status.signal ?? null);
+        break;
+    }
+    if (!groupAlive()) {
+        goneSince ??= Date.now();
+        if (Date.now() - goneSince >= EXIT_GRACE_MS) {
+            drain();
+            finalize(null, null, "command ended without reporting an exit status (Pi may have exited)");
+            break;
+        }
+    }
+    await new Promise((resolve) => setTimeout(resolve, POLL_MS));
+}
+async function waitForGate(path, timeoutMs) {
+    const deadline = Date.now() + timeoutMs;
+    while (!existsSync(path)) {
+        if (Date.now() >= deadline)
+            throw new Error("Timed out waiting for start signal");
+        await new Promise((resolve) => setTimeout(resolve, 20));
+    }
+}
