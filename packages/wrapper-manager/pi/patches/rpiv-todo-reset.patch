+	pi.registerCommand("reset-todo", {
+		description: "Clear the todo list for the current branch",
+		handler: async (_args, ctx) => {
+			const id = sid(ctx);
+			const count = getState(id).tasks.filter((task) => task.status !== "deleted").length;
+			if (count === 0) {
+				if (ctx.hasUI) ctx.ui.notify("Todo list is already empty", "info");
+				return;
+			}
+			// State entries are authoritative on replay (restart, /tree, compaction),
+			// so an empty snapshot is the whole reset.
+			const empty = { tasks: [], nextId: 1 };
+			pi.appendEntry(STATE_ENTRY_TYPE, empty);
+			replaceState(id, empty);
+			// The model still has the old list in context; tell it on the next turn.
+			pi.sendMessage(
+				{
+					customType: "rpiv-todo-reset",
+					content: "The user cleared the todo list with /reset-todo. All previous todo items and ids are gone; create new todos as needed.",
+					display: false,
+				},
+				{ deliverAs: "nextTurn" },
+			);
+			if (id === getActiveRenderSession()) await updateTodoOverlay(true);
+			if (ctx.hasUI) ctx.ui.notify(`Cleared ${count} todo${count === 1 ? "" : "s"}`, "info");
+		},
+	});
